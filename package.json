{
  "name": "@veliovgroup/client-storage",
  "version": "5.0.0",
  "description": "Bulletproof persistent client (browser) storage with pluggable drivers (localStorage, cookies, in-memory). Full TS support, TTL, Unicode, no deps",
  "main": "./client-storage.cjs",
  "module": "./client-storage.js",
  "type": "module",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./client-storage.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./client-storage.cjs"
      }
    }
  },
  "files": [
    "client-storage.js",
    "client-storage.cjs",
    "base-storage.js",
    "browser-storage.js",
    "cookies-storage.js",
    "js-storage.js",
    "helpers.js",
    "index.d.ts",
    "index.d.cts",
    "package.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "rollup -c rollup.config.js",
    "build:types": "cp ./index.d.ts ./index.d.cts",
    "build": "npm run build:cjs && npm run build:types",
    "typecheck": "tsc -p tsconfig.types.json",
    "sync:legacy-shim": "node ./scripts/sync-legacy-shim.mjs",
    "deprecate:legacy": "node ./scripts/deprecate-legacy-package.mjs",
    "publish:legacy-shim": "npm run sync:legacy-shim && cd legacy && npm install && npm publish",
    "prepublishOnly": "npm run build",
    "test": "jest --config jest.config.js && npm run typecheck",
    "test:meteor": "meteor test-packages ./",
    "test:meteor:console": "mtest --package ./ --once",
    "lint": "echo \"No linter configured\""
  },
  "keywords": [
    "browser",
    "persistent",
    "storage",
    "localstorage",
    "cookies",
    "local-storage",
    "client-storage"
  ],
  "tags": [
    "browser",
    "persistent",
    "storage",
    "localstorage",
    "cookies",
    "local-storage",
    "client-storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veliovgroup/client-storage.git"
  },
  "bugs": {
    "url": "https://github.com/veliovgroup/client-storage/issues"
  },
  "homepage": "https://github.com/veliovgroup/client-storage#readme",
  "author": "dr.dimitru (https://veliovgroup.com)",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@zodern/mtest": "^0.5.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "rollup": "^4.22.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
